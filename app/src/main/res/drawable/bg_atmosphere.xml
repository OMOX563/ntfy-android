<?xml version="1.0" encoding="utf-8"?>
<!--
  FxxkPush 液态玻璃 · 页面氛围背景
  依据 docs/design-system.md §2.5：
      页面底 bg-base → 彩色氛围斑（2-3 个低透明度 radial，透明度 ≤ 8%）→ 玻璃卡片浮于其上。

  实现说明（Android shape 的硬限制与取舍）：
  · shape 的 <gradient> 只有 linear/radial/sweep 三种，且一个 shape 只能带一个渐变，
    无法在同一个 shape 里把「底色 + 多个不同位置的 radial 斑」叠起来。
  · 因此用 <layer-list>：最底层是纯色 bg_base，上面叠三个 radial oval 斑，
    每个斑自带 gradient（centerColor 极淡 → transparent），并用
    <item> 的 android:left/top/right/bottom 把它们钉在页面的三个角落。
  · 三个斑的 alpha 取 atmosphere_blob_1/2/3（8% / 6% / 5%），均 ≤ 文档 8% 上限。
  · 浅色 / 深色两套由 values/ 与 values-night/ 的 atmosphere_blob_* 自动切换。

  踩坑记录（2026-10-15，CI 首次构建失败）：
  · android:gradientRadius 不支持百分比单位 "%p" —— AAPT 只认 px/dp/sp。
    初版写了 "55%p" 导致 mergeFdroidReleaseResources 整体失败，
    而 XML 语法解析与引用完整性检查都是绿的（本机无 SDK 查不出来）。
    现改为固定 dp 半径，斑的位置与大小由 <item> 的偏移决定。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 页面底 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_base" />
        </shape>
    </item>

    <!-- 氛围斑 1：左上角，brand @ 8% -->
    <item android:left="-120dp" android:top="-140dp" android:right="60%" android:bottom="70%">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerColor="@color/atmosphere_blob_1"
                android:startColor="@color/atmosphere_blob_1"
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- 氛围斑 2：右上偏中，brand @ 6% -->
    <item android:left="45%" android:top="8%" android:right="-140dp" android:bottom="62%">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:centerColor="@color/atmosphere_blob_2"
                android:startColor="@color/atmosphere_blob_2"
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>

    <!-- 氛围斑 3：左下角，brand-dim @ 5% -->
    <item android:left="-100dp" android:top="55%" android:right="72%" android:bottom="-160dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="280dp"
                android:centerColor="@color/atmosphere_blob_3"
                android:startColor="@color/atmosphere_blob_3"
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
