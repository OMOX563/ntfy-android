<?xml version="1.0" encoding="utf-8"?>
<!--
  FxxkPush 液态玻璃 · 徽章 / 标签（胶囊）
  依据 docs/design-system.md §3（radius-chip 999dp）与 §2.2。
  形状用 rectangle + 999dp 圆角而不是 oval：胶囊需要随内容宽度伸缩高度固定，
  oval 在多行文字时会变成椭圆，不符合「胶囊」语义。
  solid 直接用 glass_fill（半透明），描边用玻璃的暗侧描边 glass-stroke-dim。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill" />
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke_dim" />
    <corners android:radius="@dimen/radius_chip" />
</shape>
