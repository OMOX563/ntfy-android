<?xml version="1.0" encoding="utf-8"?>
<!--
  FxxkPush 液态玻璃 · 卡片内块（附件框、按钮组）
  依据 docs/design-system.md §2.2（glass-fill-strong）与 §3（radius-inner 14dp）。
  描边用 glass-stroke-dim（暗侧描边，制造厚度）。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill_strong" />
    <stroke
        android:width="@dimen/glass_stroke_width"
        android:color="@color/glass_stroke_dim" />
    <corners android:radius="@dimen/radius_inner" />
</shape>
