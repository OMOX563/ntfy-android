<?xml version="1.0" encoding="utf-8"?>
<!--
  FxxkPush 液态玻璃 · 卡片内块背景（附件框等）
  依据 docs/design-system.md §2.2（glass-fill-strong）+ §3（radius-inner 14dp）。

  为什么是 layer-list 而不是直接 @drawable/glass_inner：
  原本 detail_item_attachment_file_box 的 android:background 是
  ?android:attr/selectableItemBackground（按压缩放 + 涟漪）。换成不透明的玻璃面之后，
  按压反馈会被完全盖掉，交互就丢了。这里把可按压的 selectableItemBackground 放在
  glass_inner 之上组成 layer-list：玻璃负责质感，涟漪照旧负责反馈，两者都不牺牲。

  该背景只出现在这一个视上，不单独建 drawable（建了也只有一处调用）。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/glass_inner" />
    <item android:drawable="?android:attr/selectableItemBackground" />
</layer-list>
